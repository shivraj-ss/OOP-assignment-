#include <iostream>
using namespace std;

class Book
{
public:
    string title;
    float price;

    // Default constructor
    Book()
    {
        title = "Unknown";
        price = 0;
    }

    // Parameterized constructor
    Book(string t, float p)
    {
        title = t;
        price = p;
    }

    void display()
    {
        cout << "Title: " << title << endl;
        cout << "Price: " << price << endl;
    }
};

int main()
{
    // Object using default constructor
    Book b1;

    // Object using parameterized constructor
    Book b2("C++", 500);

    cout << "Book 1:" << endl;
    b1.display();

    cout << "\nBook 2:" << endl;
    b2.display();

    return 0;
}
