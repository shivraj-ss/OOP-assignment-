#include <iostream>
using namespace std;

class Student
{
public:
    string name;
    int rollNo;
    int age;

    void input()
    {
        cout << "Enter student name: ";
        cin >> name;

        cout << "Enter roll number: ";
        cin >> rollNo;

        cout << "Enter age: ";
        cin >> age;
    }

    void display()
    {
        cout << "\nStudent Details:" << endl;
        cout << "Name: " << name << endl;
        cout << "Roll No: " << rollNo << endl;
        cout << "Age: " << age << endl;
    }
};

int main()
{
    Student s;

    s.input();
    s.display();

    return 0;
}
